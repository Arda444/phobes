# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android signing — NEVER commit keystore or key.properties
android/key.properties
android/app/*.jks

# Secret files — NEVER commit Firebase service-account keys.
# Revoke any leaked keys immediately in Firebase Console > Service Accounts.
serviceAccountKey.json
**/serviceAccountKey*.json
**/pserviceAccountKey*.json
admin-cli/*.json
!admin-cli/package.json
!admin-cli/package-lock.json
android/app/google-services.json
ios/Runner/GoogleService-Info.plist

# Windows build artifacts
/windows/flutter/ephemeral/
/windows/runner/Release/
/windows/runner/Debug/
/windows/runner/*.dir/
*.obj
*.pdb
*.tlog
*.recipe
*.dll
*.exe
*.exp
*.lib
*.manifest
*.res
*.sln
*.vcxproj
*.filters

# Web build artifacts
/build/web/

# APK staged into web/ for direct download (re-generated by build pipeline)
/web/phobes.apk

# Firebase local deploy cache
.firebase/

# IDE / agent tooling (local only)
.vscode/
.vs/
.playwright-mcp/
.mcp.json
.cursor/

# Analyzer / debug dumps (do not commit)
analysis_report*.txt
analysis_v*.txt
total_analysis_report.txt
analyze_output.txt

# Cloud Functions compile output
functions/lib/
functions/node_modules/

# Firestore rules tests
rules_test/node_modules/

# Windows desktop build artifacts (see also windows/.gitignore)
windows/CMakeCache.txt
windows/cmake_install.cmake
windows/CMakeFiles/
windows/*.zip
windows/extracted/
windows/include/
windows/packages/
windows/plugins/
windows/generated/
windows/*.zip

# Promo / scratch (not part of the app)